# Copy this file to server/.env and adjust as needed.
# Every value below is optional — the server falls back to the defaults shown.

# --- Server ---------------------------------------------------------------
PORT=4000
# Origin allowed by CORS / used to build links in emails (the web client).
WEB_ORIGIN=http://localhost:5173
# Set to "production" to serve the built client and enable secure cookies.
# NODE_ENV=production

# --- Auth -----------------------------------------------------------------
# CHANGE THIS in production. Anyone with the value can forge sessions.
JWT_SECRET=dev-secret-change-me
# Auth cookie lifetime in hours (default 7 days).
SESSION_TTL_HOURS=168

# --- Database -------------------------------------------------------------
# SQLite (default): path is relative to the server/ folder.
DATABASE_FILE=./data/bongchat.db
# PostgreSQL: set DB_CLIENT=pg and provide DATABASE_URL.
# DB_CLIENT=pg
# DATABASE_URL=postgres://user:password@localhost:5432/bongchat

# --- Uploads --------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
# Largest story video accepted (megabytes).
MAX_VIDEO_MB=50

# --- Stories --------------------------------------------------------------
STORY_TTL_HOURS=24

# --- AI assistant ---------------------------------------------------------
# Leave these unset to use the built-in offline assistant.
# When set, requests are proxied to any OpenAI-compatible endpoint.
# AI_PROVIDER=openai
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
