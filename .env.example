# Variables for `docker compose` (docker-compose.yml). Copy to `.env` and edit.
# These configure the *container*, not a local `npm run dev` session — see
# server/.env.example for running the app directly on your machine.

# Public origin of the app. Used for CORS and links; set to your https URL
# behind a reverse proxy, e.g. https://chat.example.com
WEB_ORIGIN=http://localhost:4000

# REQUIRED in production — generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production
