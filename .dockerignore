# Keep the Docker build context small and reproducible.
node_modules
**/node_modules

# Build output is produced fresh inside the image.
client/dist
server/dist

# Local data, uploads and env files must never be baked into an image.
server/data
server/uploads
server/.env
.env
.env.*

# Tooling and editor noise.
.git
.gitignore
.vscode
.idea
*.log
npm-debug.log*
Dockerfile
docker-compose.yml
.dockerignore
README.md
